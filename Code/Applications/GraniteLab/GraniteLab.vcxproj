<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{10F56EA1-6F2C-485C-A44A-CC6C7D0A93DE}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <ProjectName>Granite Lab</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <LabRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</LabRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(LabRoot)Build\x64_Debug\</OutDir>
    <IntDir>$(LabRoot)Build\_Temp\GraniteLabEntry\</IntDir>
    <NMakeBuildCommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(LabRoot)Code\Game\Provenance\Verification\Scripts\BuildGraniteLab.ps1"</NMakeBuildCommandLine>
    <!-- Rebuild intentionally performs incremental build: never clean shared outputs. -->
    <NMakeReBuildCommandLine>$(NMakeBuildCommandLine)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>echo Granite Lab shares production outputs. Clean is intentionally a no-op.</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)EsotericaEditor.exe</NMakeOutput>
    <LocalDebuggerCommand>$(OutDir)EsotericaEditor.exe</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments>-map data://provenance/provenancesandbox.map</LocalDebuggerCommandArguments>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
