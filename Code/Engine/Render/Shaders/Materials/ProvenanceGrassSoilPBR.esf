#define EE_MATERIAL_VERTEX_DEFORM
#include "Engine/Render/Shaders/Renderer/DefaultMeshShader.esh"
#include "Engine/Render/Shaders/Renderer/MaterialShaderPBR.esh"
#include "Engine/Render/Shaders/Materials/ProvenanceGrassWind.esh"

ESF_PARAMETER string ShaderType = "Material";

// Provenance geometry is generated and fractured at runtime, so it does not
// have an authored UV contract. This material deliberately derives all
// sampling coordinates from world position. Geometry remains authoritative
// for fracture, socket, detachment, and spall shape.
ESF_CUSTOM_PARAMETERS struct CustomParameters : ShaderParameters
{
    Texture2D                       m_albedoTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    Texture2D                       m_normalTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultNormal.texture" );
    Texture2D                       m_grassAlbedoTexture        ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    Texture2D                       m_grassNormalTexture        ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultNormal.texture" );
    Texture2D                       m_grassBladeAtlasA          ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    Texture2D                       m_grassBladeAtlasB          ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    Texture2D                       m_coverTexture              ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    Texture2D                       m_mudAlbedoTexture          ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    float                           m_coverEnabled              ESF_DEFAULT_VALUE( 0.0F );
    float                           m_windPhase                 ESF_DEFAULT_VALUE( 0.0F );
    float                           m_windTipMeters             ESF_DEFAULT_VALUE( 0.04F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 0.05F );
    float                           m_grassNormalStrength       ESF_DEFAULT_VALUE( 0.3F );
    float                           m_grassTileScaleMeters      ESF_DEFAULT_VALUE( 1.0F );
    float                           m_tileScaleMeters           ESF_DEFAULT_VALUE( 1.25F ) ESF_MIN_VALUE( 0.05F ) ESF_MAX_VALUE( 100.0F );
    float                           m_normalStrength            ESF_DEFAULT_VALUE( 0.45F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
    float                           m_roughness                 ESF_DEFAULT_VALUE( 0.75F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
};

#include "Engine/_Module/_AutoGenerated/ShaderReflection/ProvenanceGrassSoilPBR.esh"

// Three translated copies blend on a continuous triangular lattice.
// Color and normal use identical offsets/weights. Explicit derivatives avoid
// false coarse mip selection at hash boundaries. No image regeneration.
struct SoilSample { float4 color; float2 normal; };
uint GrassBladeHash(uint value)
{
    value^=value>>16;value*=0x7feb352dU;value^=value>>15;value*=0x846ca68bU;value^=value>>16;return value;
}
float GrassBladeUnit(uint value) { return float(value&0xffffU)/65535.0F; }

void MaterialVertexDeform(inout VertexOutput vertex, uint shaderParametersOffsetIn32ByteBlocks)
{
    float3 n=normalize(vertex.m_worldNormal);
    float2 code=n.xy/max(-n.z,.0001F);
    bool blade=n.z<-.80F&&all(code>float2(.159F,.349F))&&all(code<float2(.201F,.391F));
    if(!blade)return; // Shared soil material never moves the terrain.

    // Retain interpolated rest position for atlas sampling. Sampling deformed
    // world coordinates would slide the cutout across its card and resurrect
    // the clipped tips/rectangular islands. Color is unused by this material.
    vertex.m_color=float4(vertex.m_worldPosition,1.0F);
    if(vertex.m_uv.x<.5F)return; // Legacy/unweighted cards stay still.
    ByteAddressBuffer shaderDataBuffer=GetBuffer(RootCBV.m_shaderDataBuffer);
    CustomParameters parameters=LoadCustomParameters(shaderDataBuffer,shaderParametersOffsetIn32ByteBlocks);
    float2 cell=min(floor(saturate((code-float2(.16F,.35F))/.04F)*128.0F),127.0F.xx);
    uint id=uint(cell.x)+uint(cell.y)*128U;
    float spatial=dot(cell,float2(.081F,.053F));
    float tuft=6.283185307F*GrassBladeUnit(GrassBladeHash(id+0x9e3779b9U));
    float phase=parameters.m_windPhase;
    float along=GrassWindAlong(phase,spatial,tuft);
    float across=GrassWindAcross(phase,spatial,tuft);
    float amount=clamp(parameters.m_windTipMeters,0.0F,.05F)*GrassWindWeight(saturate(vertex.m_uv.y));
    amount*=step(.5F,parameters.m_coverEnabled);
    // Fixed prevailing direction, coherent traveling waves, per-tuft flutter.
    // Maximum displacement < 5.1 cm; CPU instance + meshlet padding is 6 cm.
    vertex.m_worldPosition.xy+=amount*(float2(.8F,.6F)*along+float2(-.6F,.8F)*across);
}
float2 SoilOffset(float2 cell)
{
    return frac(sin(float2(dot(cell,float2(127.1F,311.7F)),dot(cell,float2(269.5F,183.3F))))*43758.5453F);
}
SoilSample SampleSoil(Texture2D colorMap, Texture2D normalMap, SamplerState samplerState, float2 uv, float2 dx, float2 dy)
{
    float2 grid = float2(uv.x - uv.y * 0.577350269F, uv.y * 1.154700538F) * 0.73F;
    float2 cell = floor(grid), f = frac(grid);
    float2 a, b, c;
    float3 weights;
    if(f.x+f.y<1.0F) { a=cell; b=cell+float2(1,0); c=cell+float2(0,1); weights=float3(1-f.x-f.y,f.x,f.y); }
    else { a=cell+1; b=cell+float2(0,1); c=cell+float2(1,0); weights=float3(f.x+f.y-1,1-f.x,1-f.y); }
    weights=weights*weights*(3.0F-2.0F*weights);
    weights/=dot(weights,1.0F.xxx);
    float2 ua=uv+SoilOffset(a), ub=uv+SoilOffset(b), uc=uv+SoilOffset(c);
    SoilSample result;
    result.color=colorMap.SampleGrad(samplerState,ua,dx,dy)*weights.x+colorMap.SampleGrad(samplerState,ub,dx,dy)*weights.y+colorMap.SampleGrad(samplerState,uc,dx,dy)*weights.z;
    result.normal=normalMap.SampleGrad(samplerState,ua,dx,dy).rg*weights.x+normalMap.SampleGrad(samplerState,ub,dx,dy).rg*weights.y+normalMap.SampleGrad(samplerState,uc,dx,dy).rg*weights.z;
    return result;
}

MaterialShaderOutput MaterialShaderMain( in MaterialShaderInput materialInput )
{
    ByteAddressBuffer shaderDataBuffer = GetBuffer( RootCBV.m_shaderDataBuffer );

    CustomParameters customParameters = LoadCustomParameters
    (
        shaderDataBuffer,
        materialInput.m_primitive.GetShaderParametersOffsetIn32ByteBlocks()
    );

    MaterialShaderOutput materialOutput = MaterialShaderOutput::New( materialInput );

    float3 worldPosition = materialInput.m_vertex.m_worldPosition;
    float3 geometryNormal = normalize( materialInput.m_vertex.m_worldNormal );
    // Procedural blade cards carry their stable cover-cell identity in a
    // reserved normal cone. The X/-Z and Y/-Z ratios survive normalization.
    float2 bladeCode=geometryNormal.xy/max(-geometryNormal.z,.0001F);
    bool isGrassBlade=geometryNormal.z<-.80F&&all(bladeCode>float2(.159F,.349F))&&all(bladeCode<float2(.201F,.391F));
    [branch] if(isGrassBlade)
    {
        worldPosition=materialInput.m_vertex.m_color.xyz;
        static const float2 coverOrigin=float2(-5.4F,31.0F);
        static const float2 coverSize=float2(11.04F,10.56F);
        static const float2 coverCell=coverSize/128.0F;
        float2 encodedCell=saturate((bladeCode-float2(.16F,.35F))/.04F)*128.0F;
        float2 cellIndex=floor(encodedCell);
        cellIndex=min(cellIndex,127.0F.xx);
        // CPU placement stores deterministic slope/moisture vigor inside the
        // fractional X code while the integer portion remains the cover cell.
        float vigor=saturate((frac(encodedCell.x)-.08F)/.84F);
        uint linearCell=uint(max(cellIndex.x,0.0F))+uint(max(cellIndex.y,0.0F))*128U;
        uint h=GrassBladeHash(linearCell+0x9e3779b9U);
        float2 jitter=float2(GrassBladeUnit(GrassBladeHash(h^0x34b91a7dU))-.5F,GrassBladeUnit(GrassBladeHash(h^0xc2b2ae35U))-.5F)*coverCell*.90F;
        float2 cellCenter=coverOrigin+(cellIndex+.5F)*coverCell+jitter;
        float cardWidth=.115F+.045F*GrassBladeUnit(h>>1);
        float cardHeight=.3048F+.1524F*vigor;
        SamplerState bladeSampler=GetLinearClampSampler();
        bool meadow=materialInput.m_vertex.m_uv.x>1.5F;
        float3 coverMask=float3(1,0,1);
        if(!meadow)coverMask=customParameters.m_coverTexture.SampleLevel(bladeSampler,(cellCenter-coverOrigin)/coverSize,0).rgb;
        else cellCenter=worldPosition.xy;
        // Explicit card coordinates remain valid for any world position and
        // height. Never clamp exterior tufts into the lab's finite wear texture.
        float2 cardUV=materialInput.m_vertex.m_uv.zw;
        // Never clamp geometry beyond a tile back onto its edge texels. The
        // cards begin 4 mm above the stored cover height, so their upper edge
        // otherwise samples a neighboring sprite's top-row remnants and
        // stretches them into the floating rectangular strips seen in play.
        clip(min(min(cardUV.x,1.0F-cardUV.x),min(cardUV.y-.012F,1.0F-cardUV.y)));
        float threshold=.08F+.82F*GrassBladeUnit(GrassBladeHash(h^0x68bc21ebU));
        float visible=smoothstep(threshold-.06F,threshold+.03F,coverMask.r)*coverMask.b*step(.5F,customParameters.m_coverEnabled);
        uint variant=(h>>17)&7U;
        // Each atlas is a strict 4x2 sheet. Some source silhouettes touch a
        // neighboring cell, so keep filtering inside the selected tile and
        // reject the few disconnected spill islands instead of displaying
        // them as floating rectangular blade bands above another tuft.
        float2 localUV=clamp(cardUV,float2(.5F/384.0F,.5F/512.0F),float2(1.0F-.5F/384.0F,1.0F-.5F/512.0F));
        float2 atlasUV=(float2(float(variant&3U),float(variant>>2))+localUV)/float2(4.0F,2.0F);
        bool useAtlasB=(h&0x01000000U)!=0U;
        float4 blade=useAtlasB?customParameters.m_grassBladeAtlasB.Sample(bladeSampler,atlasUV):customParameters.m_grassBladeAtlasA.Sample(bladeSampler,atlasUV);
        float2 atlasPixel=localUV*float2(384.0F,512.0F);bool spill=false;
        if(!useAtlasB)
        {
            spill=(variant==1U&&atlasPixel.x<7&&atlasPixel.y>323&&atlasPixel.y<335)
                ||(variant==2U&&atlasPixel.x>363&&atlasPixel.y>278&&atlasPixel.y<298)
                ||(variant==5U&&atlasPixel.x>364&&atlasPixel.y>336&&atlasPixel.y<375)
                ||(variant==6U&&atlasPixel.x>360&&atlasPixel.y>231&&atlasPixel.y<282)
                ||(variant==6U&&atlasPixel.x>376&&atlasPixel.y>120&&atlasPixel.y<136);
        }
        else
        {
            spill=(variant==2U&&atlasPixel.x<26&&atlasPixel.y>117&&atlasPixel.y<169)
                ||(variant==2U&&atlasPixel.x>375&&atlasPixel.y>172&&atlasPixel.y<182)
                ||(variant==3U&&atlasPixel.x<29&&atlasPixel.y>434&&atlasPixel.y<481)
                ||(variant==6U&&atlasPixel.x<44&&atlasPixel.y>377&&atlasPixel.y<452)
                ||(variant==6U&&atlasPixel.x<10&&atlasPixel.y>298&&atlasPixel.y<361)
                ||(variant==7U&&atlasPixel.x<36&&atlasPixel.y>184&&atlasPixel.y<214)
                ||(variant==7U&&atlasPixel.x<13&&atlasPixel.y>335&&atlasPixel.y<376)
                ||(variant==7U&&atlasPixel.x<7&&atlasPixel.y>429&&atlasPixel.y<447);
        }
        clip(min((spill?-1.0F:blade.a-.20F),visible-.05F));
        // Grade the complete cutout toward the actual ground-cover texture.
        // Keep the original alpha/detail: the former root-luminance clip ate
        // legitimate brown stems without addressing the terrain shadow band.
        SamplerState terrainSampler=GetLinearWrapSampler();
        float2 terrainUV=cellCenter/max(.05F,customParameters.m_grassTileScaleMeters);
        float3 terrainTone=customParameters.m_grassAlbedoTexture.SampleLevel(terrainSampler,terrainUV,3.0F).rgb;
        // Preserve more of the atlas' natural hue, then add restrained
        // saturation and a moss-green grade. This reads richer beside the
        // terrain without restoring the former luminous yellow-green cards.
        float3 bladeColor=lerp(blade.rgb,terrainTone,.68F)*.60F;
        float bladeLuma=dot(bladeColor,float3(.2126F,.7152F,.0722F));
        bladeColor=lerp(bladeLuma.xxx,bladeColor,1.22F)*float3(.94F,1.04F,.88F);
        // Short/exposed tufts retain a warmer dry cast; sheltered vigorous
        // growth receives a subtle deep-green grade. Both share the atlas,
        // so this changes ecology without creating patterned color rows.
        bladeColor=saturate(bladeColor*lerp(float3(1.04F,.97F,.84F),float3(.91F,1.08F,.94F),vigor));
        materialOutput.m_albedo=bladeColor;
        materialOutput.m_emissiveColor=0.0F.xxx;
        // The shared material is alpha-tested. Terrain remains fully opaque,
        // while blade cards forward the atlas cutout and cover visibility to
        // the material alpha-test permutation.
        materialOutput.m_opacity=blade.a*visible;
        // One world-up foliage normal for every plane and both card faces.
        // Shape/color still vary per atlas tile; illumination no longer does.
        materialOutput.m_normal=float3(0.0F,0.0F,1.0F);
        // The input normal encodes cover-cell identity and points DOWN. It
        // must not bias shadow samples into the terrain beneath the blades.
        // Keep this direction independent of two-sided lighting face flips.
        materialOutput.m_shadowNormal=float3(0.0F,0.0F,1.0F);
        materialOutput.m_metalness=0.0F;
        materialOutput.m_roughness=.86F;
        materialOutput.m_occlusion=1.0F;
        // Keep screen-space AO off the thin cards, but receive directional
        // shadows at each wind-deformed blade pixel through the normal PBR
        // path. This attenuates direct sun only; environment light remains.
        // Do not set DISABLE_CAST_SHADOWS here: despite its name, that flag
        // disables RECEIVING. Actual grass casting is the F8 mesh view layer.
        materialOutput.m_primitiveFlags.m_rendererGlobalFlags|=RENDERER_GLOBAL_FLAG_DISABLE_SSAO;
        return materialOutput;
    }
    // Lab-local coverage is a WORLD-owned runtime texture, not terrain geometry.
    // R=density, G=world surface height, B=eligible. Height qualification keeps
    // tunnel interiors and buried surfaces bare even beneath an intact roof.
    float2 coverUV = (worldPosition.xy-float2(-5.4F,31.0F))/float2(11.04F,10.56F);
    float cover=0;
    // UV.x=-2-mud is reserved for immutable full-floor landscape tiles. Their
    // ground cover is independent of the finite interactive lab texture.
    bool isLandscape=materialInput.m_vertex.m_uv.x < -1.5F;
    [branch] if(isLandscape)
    {
        cover=saturate(materialInput.m_vertex.m_uv.y)*smoothstep(.45F,.75F,geometryNormal.z);
    }
    else if(customParameters.m_coverEnabled>0.5F && all(coverUV>=0) && all(coverUV<=1))
    {
        SamplerState coverSampler=GetLinearClampSampler();
        float3 mask=customParameters.m_coverTexture.SampleLevel(coverSampler,coverUV,0).rgb;
        float2 cell=floor(worldPosition.xy*11.0F),f=frac(worldPosition.xy*11.0F);f=f*f*(3-2*f);
        float noise=lerp(lerp(SoilOffset(cell).x,SoilOffset(cell+float2(1,0)).x,f.x),lerp(SoilOffset(cell+float2(0,1)).x,SoilOffset(cell+1).x,f.x),f.y);
        cover=smoothstep(noise*.30F,.70F+noise*.30F,mask.r)*mask.b;
        cover*=1-smoothstep(.012F,.035F,abs(worldPosition.z-mask.g));
        cover*=smoothstep(.45F,.75F,geometryNormal.z);
    }
    float3 axisSign = float3
    (
        geometryNormal.x >= 0.0F ? 1.0F : -1.0F,
        geometryNormal.y >= 0.0F ? 1.0F : -1.0F,
        geometryNormal.z >= 0.0F ? 1.0F : -1.0F
    );

    float tileScaleMeters = max( customParameters.m_tileScaleMeters, 0.001F );
    float reciprocalTileScale = rcp( tileScaleMeters );
    SamplerState textureSampler = GetLinearWrapSampler();

    // Sign-aware coordinates keep opposing projections consistently oriented.
    float2 uvX = float2( worldPosition.z * axisSign.x, -worldPosition.y ) * reciprocalTileScale;
    float2 uvY = float2( worldPosition.x, -worldPosition.z * axisSign.y ) * reciprocalTileScale;
    float2 uvZ = float2( worldPosition.x * axisSign.z, worldPosition.y ) * reciprocalTileScale;

    float3 blendWeights = pow( abs( geometryNormal ), 4.0F.xxx );
    blendWeights /= max( blendWeights.x + blendWeights.y + blendWeights.z, 0.0001F );

    float4 albedo = 0;
    float3 perturbation = 0;
    float2 gx = ddx(uvX), gy = ddy(uvX);
    float2 hx = ddx(uvY), hy = ddy(uvY);
    float2 ix = ddx(uvZ), iy = ddy(uvZ);
    float strength = saturate(customParameters.m_normalStrength);
    [branch] if (blendWeights.x > 0.001F && cover < .999F)
    {
        SoilSample s = SampleSoil(customParameters.m_albedoTexture, customParameters.m_normalTexture, textureSampler, uvX, gx, gy);
        albedo += s.color * blendWeights.x;
        float2 n = (s.normal * 2.0F - 1.0F) * strength;
        perturbation += float3(0, -n.y, n.x * axisSign.x) * blendWeights.x;
    }
    [branch] if (blendWeights.y > 0.001F && cover < .999F)
    {
        SoilSample s = SampleSoil(customParameters.m_albedoTexture, customParameters.m_normalTexture, textureSampler, uvY, hx, hy);
        albedo += s.color * blendWeights.y;
        float2 n = (s.normal * 2.0F - 1.0F) * strength;
        perturbation += float3(n.x, 0, -n.y * axisSign.y) * blendWeights.y;
    }
    [branch] if (blendWeights.z > 0.001F && cover < .999F)
    {
        SoilSample s = SampleSoil(customParameters.m_albedoTexture, customParameters.m_normalTexture, textureSampler, uvZ, ix, iy);
        albedo += s.color * blendWeights.z;
        float2 n = (s.normal * 2.0F - 1.0F) * strength;
        perturbation += float3(n.x * axisSign.z, n.y, 0) * blendWeights.z;
    }
    float2 grassUV=worldPosition.xy/max(.05F,customParameters.m_grassTileScaleMeters);
    float2 grassDx=ddx(grassUV),grassDy=ddy(grassUV);
    [branch] if(cover>.001F)
    {
        SoilSample grass=SampleSoil(customParameters.m_grassAlbedoTexture,customParameters.m_grassNormalTexture,textureSampler,grassUV,grassDx,grassDy);
        albedo=lerp(albedo,grass.color,cover);
        perturbation=lerp(perturbation,float3((grass.normal*2-1)*customParameters.m_grassNormalStrength,0),cover);
    }
    // Color-only silty sediment source. No invented wetness, puddles, height
    // or copied soil normal detail. One additional sample only in mud pixels.
    float mud=isLandscape?saturate(-materialInput.m_vertex.m_uv.x-2.0F):0.0F;
    mud*=1.0F-cover;
    float2 mudUV=worldPosition.xy/.9F;
    float2 mudDx=ddx(mudUV),mudDy=ddy(mudUV);
    [branch] if(mud>.001F)
    {
        float4 sediment=customParameters.m_mudAlbedoTexture.SampleGrad(textureSampler,mudUV,mudDx,mudDy);
        albedo.rgb=lerp(albedo.rgb,sediment.rgb,mud);
        perturbation*=1.0F-mud;
    }
    perturbation -= geometryNormal * dot(geometryNormal, perturbation);

    materialOutput.m_albedo = albedo.rgb;
    materialOutput.m_opacity = albedo.a * customParameters.m_opacity;
    materialOutput.m_normal = normalize( geometryNormal + perturbation );
    materialOutput.m_metalness = 0.0F;
    materialOutput.m_roughness = saturate( customParameters.m_roughness );
    materialOutput.m_occlusion = 1.0F;

    return materialOutput;
}
