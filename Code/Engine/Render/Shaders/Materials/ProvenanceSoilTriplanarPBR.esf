#include "Engine/Render/Shaders/Renderer/DefaultMeshShader.esh"
#include "Engine/Render/Shaders/Renderer/MaterialShaderPBR.esh"

ESF_PARAMETER string ShaderType = "Material";

// Provenance geometry is generated and fractured at runtime, so it does not
// have an authored UV contract. This material deliberately derives all
// sampling coordinates from world position. Geometry remains authoritative
// for fracture, socket, detachment, and spall shape.
ESF_CUSTOM_PARAMETERS struct CustomParameters : ShaderParameters
{
    Texture2D                       m_albedoTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    Texture2D                       m_normalTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultNormal.texture" );
    float                           m_tileScaleMeters           ESF_DEFAULT_VALUE( 1.25F ) ESF_MIN_VALUE( 0.05F ) ESF_MAX_VALUE( 100.0F );
    float                           m_normalStrength            ESF_DEFAULT_VALUE( 0.45F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
    float                           m_roughness                 ESF_DEFAULT_VALUE( 0.75F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
};

#include "Engine/_Module/_AutoGenerated/ShaderReflection/ProvenanceSoilTriplanarPBR.esh"

// Three translated copies blend on a continuous triangular lattice.
// Color and normal use identical offsets/weights. Explicit derivatives avoid
// false coarse mip selection at hash boundaries. No image regeneration.
struct SoilSample { float4 color; float2 normal; };
float2 SoilOffset(float2 cell)
{
    return frac(sin(float2(dot(cell,float2(127.1F,311.7F)),dot(cell,float2(269.5F,183.3F))))*43758.5453F);
}
SoilSample SampleSoil(Texture2D colorMap, Texture2D normalMap, SamplerState samplerState, float2 uv, float2 dx, float2 dy)
{
    float2 grid = float2(uv.x - uv.y * 0.577350269F, uv.y * 1.154700538F) * 0.73F;
    float2 cell = floor(grid), f = frac(grid);
    float2 a, b, c;
    float3 weights;
    if(f.x+f.y<1.0F) { a=cell; b=cell+float2(1,0); c=cell+float2(0,1); weights=float3(1-f.x-f.y,f.x,f.y); }
    else { a=cell+1; b=cell+float2(0,1); c=cell+float2(1,0); weights=float3(f.x+f.y-1,1-f.x,1-f.y); }
    weights=weights*weights*(3.0F-2.0F*weights);
    weights/=dot(weights,1.0F.xxx);
    float2 ua=uv+SoilOffset(a), ub=uv+SoilOffset(b), uc=uv+SoilOffset(c);
    SoilSample result;
    result.color=colorMap.SampleGrad(samplerState,ua,dx,dy)*weights.x+colorMap.SampleGrad(samplerState,ub,dx,dy)*weights.y+colorMap.SampleGrad(samplerState,uc,dx,dy)*weights.z;
    result.normal=normalMap.SampleGrad(samplerState,ua,dx,dy).rg*weights.x+normalMap.SampleGrad(samplerState,ub,dx,dy).rg*weights.y+normalMap.SampleGrad(samplerState,uc,dx,dy).rg*weights.z;
    return result;
}

MaterialShaderOutput MaterialShaderMain( in MaterialShaderInput materialInput )
{
    ByteAddressBuffer shaderDataBuffer = GetBuffer( RootCBV.m_shaderDataBuffer );

    CustomParameters customParameters = LoadCustomParameters
    (
        shaderDataBuffer,
        materialInput.m_primitive.GetShaderParametersOffsetIn32ByteBlocks()
    );

    MaterialShaderOutput materialOutput = MaterialShaderOutput::New( materialInput );

    float3 worldPosition = materialInput.m_vertex.m_worldPosition;
    float3 geometryNormal = normalize( materialInput.m_vertex.m_worldNormal );
    float3 axisSign = float3
    (
        geometryNormal.x >= 0.0F ? 1.0F : -1.0F,
        geometryNormal.y >= 0.0F ? 1.0F : -1.0F,
        geometryNormal.z >= 0.0F ? 1.0F : -1.0F
    );

    float tileScaleMeters = max( customParameters.m_tileScaleMeters, 0.001F );
    float reciprocalTileScale = rcp( tileScaleMeters );
    SamplerState textureSampler = GetLinearWrapSampler();

    // Sign-aware coordinates keep opposing projections consistently oriented.
    float2 uvX = float2( worldPosition.z * axisSign.x, -worldPosition.y ) * reciprocalTileScale;
    float2 uvY = float2( worldPosition.x, -worldPosition.z * axisSign.y ) * reciprocalTileScale;
    float2 uvZ = float2( worldPosition.x * axisSign.z, worldPosition.y ) * reciprocalTileScale;

    float3 blendWeights = pow( abs( geometryNormal ), 4.0F.xxx );
    blendWeights /= max( blendWeights.x + blendWeights.y + blendWeights.z, 0.0001F );

    float4 albedo = 0;
    float3 perturbation = 0;
    float2 gx = ddx(uvX), gy = ddy(uvX);
    float2 hx = ddx(uvY), hy = ddy(uvY);
    float2 ix = ddx(uvZ), iy = ddy(uvZ);
    float strength = saturate(customParameters.m_normalStrength);
    [branch] if (blendWeights.x > 0.001F)
    {
        SoilSample s = SampleSoil(customParameters.m_albedoTexture, customParameters.m_normalTexture, textureSampler, uvX, gx, gy);
        albedo += s.color * blendWeights.x;
        float2 n = (s.normal * 2.0F - 1.0F) * strength;
        perturbation += float3(0, -n.y, n.x * axisSign.x) * blendWeights.x;
    }
    [branch] if (blendWeights.y > 0.001F)
    {
        SoilSample s = SampleSoil(customParameters.m_albedoTexture, customParameters.m_normalTexture, textureSampler, uvY, hx, hy);
        albedo += s.color * blendWeights.y;
        float2 n = (s.normal * 2.0F - 1.0F) * strength;
        perturbation += float3(n.x, 0, -n.y * axisSign.y) * blendWeights.y;
    }
    [branch] if (blendWeights.z > 0.001F)
    {
        SoilSample s = SampleSoil(customParameters.m_albedoTexture, customParameters.m_normalTexture, textureSampler, uvZ, ix, iy);
        albedo += s.color * blendWeights.z;
        float2 n = (s.normal * 2.0F - 1.0F) * strength;
        perturbation += float3(n.x * axisSign.z, n.y, 0) * blendWeights.z;
    }
    perturbation -= geometryNormal * dot(geometryNormal, perturbation);

    materialOutput.m_albedo = albedo.rgb;
    materialOutput.m_opacity = albedo.a * customParameters.m_opacity;
    materialOutput.m_normal = normalize( geometryNormal + perturbation );
    materialOutput.m_metalness = 0.0F;
    materialOutput.m_roughness = saturate( customParameters.m_roughness );
    materialOutput.m_occlusion = 1.0F;

    return materialOutput;
}
