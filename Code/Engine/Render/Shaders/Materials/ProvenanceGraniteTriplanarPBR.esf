#include "Engine/Render/Shaders/Renderer/DefaultMeshShader.esh"
#include "Engine/Render/Shaders/Renderer/MaterialShaderPBR.esh"

ESF_PARAMETER string ShaderType = "Material";

// Provenance geometry is generated and fractured at runtime, so it does not
// have an authored UV contract. This material deliberately derives all
// sampling coordinates from world position for the host. Detached granite
// carries immutable source coordinates/normals in UV0/UV1/color, so its mineral
// pattern and weathering travel with it, including world-baked sleeping batches.
// Geometry remains authoritative
// for fracture, socket, detachment, and spall shape.
ESF_CUSTOM_PARAMETERS struct CustomParameters : ShaderParameters
{
    Texture2D                       m_albedoTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultColor.texture" );
    Texture2D                       m_normalTexture             ESF_DEFAULT_VALUE( "data://Render/Textures/DefaultNormal.texture" );
    float                           m_tileScaleMeters           ESF_DEFAULT_VALUE( 1.25F ) ESF_MIN_VALUE( 0.05F ) ESF_MAX_VALUE( 100.0F );
    float                           m_normalStrength            ESF_DEFAULT_VALUE( 0.45F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
    float                           m_roughness                 ESF_DEFAULT_VALUE( 0.75F ) ESF_MIN_VALUE( 0.0F ) ESF_MAX_VALUE( 1.0F );
};

#include "Engine/_Module/_AutoGenerated/ShaderReflection/ProvenanceGraniteTriplanarPBR.esh"

float3 UnpackGraniteNormal( float2 packedNormal, float strength )
{
    float2 normalXY = ( packedNormal * 2.0F - 1.0F.xx ) * strength;
    float normalZ = sqrt( 1.0F - saturate( dot( normalXY, normalXY ) ) );
    return float3( normalXY, normalZ );
}

float SoilSmooth( float t )
{
    t = saturate( t );
    return t * t * ( 3.0F - 2.0F * t );
}

float SoilGaussian( float2 p, float2 center, float2 spread )
{
    float2 d = ( p - center ) / spread;
    return exp( -dot( d, d ) );
}

float SoilFan( float2 p, float2 mouth, float2 tip, float baseWidth )
{
    float2 axis = tip - mouth;
    float lengthSquared = dot( axis, axis );
    float length = sqrt( lengthSquared );
    float2 offset = p - mouth;
    float t = dot( offset, axis ) / lengthSquared;
    float across = abs( offset.x * axis.y - offset.y * axis.x ) / length;
    float width = .020F + baseWidth * ( 1.0F - saturate( t ) );
    float along = SoilSmooth( t / .16F ) * SoilSmooth( ( 1.0F - t ) / .20F );
    float side = 1.0F - SoilSmooth( ( across - width * .72F ) / ( width * .28F + .012F ) );
    return along * side;
}

float SegmentDistance( float2 p, float2 a, float2 b )
{
    float2 axis = b - a;
    float t = saturate( dot( p - a, axis ) / dot( axis, axis ) );
    return length( p - ( a + t * axis ) );
}

// Mirrors the deterministic initial heightfield immediately around this lab
// outcrop. Staining can therefore follow real bank contact instead of a
// uniform world-height ring. Runtime excavation deliberately does not paint
// fresh dirt onto the granite until an actual material-data path exists.
float SeededSoilHeight( float2 p )
{
    float2 center = float2( 2.10F, 1.20F );
    float2 d = ( p - center ) / float2( 3.024F, 2.28F );
    float angle = atan2( d.y, d.x );
    float edgeWobble = .045F * sin( angle * 3.0F + 1.1F ) + .025F * sin( angle * 7.0F - .8F );
    float radius = length( d ) + edgeWobble;
    float skirt = 1.0F - SoilSmooth( ( radius - .54F ) / .52F );
    float fieldFade = SoilSmooth( ( p.x + 4.0F ) / 1.8F ) * SoilSmooth( ( 7.04F - p.x ) / 1.8F )
        * SoilSmooth( ( p.y + 4.0F ) / 1.8F ) * SoilSmooth( ( 6.56F - p.y ) / 1.8F );
    float reliefMask = SoilSmooth( ( radius - .72F ) / .90F );
    float rolling = .459F + .365F * sin( p.x * .45F + .31F ) * sin( p.y * .38F - 1.07F )
        + .162F * sin( p.x * .28F + p.y * .31F + .73F ) + .081F * sin( p.x * .93F - p.y * .52F - 1.21F );
    float2 uv = p / float2( 4.2F, 2.4F );
    bool inside = all( uv >= 0.0F.xx ) && all( uv <= 1.0F.xx );
    float outsideX = max( max( -p.x, p.x - 4.2F ), 0.0F );
    float outsideY = max( max( -p.y, p.y - 2.4F ), 0.0F );
    float edgeMeters = inside ? min( min( p.x, 4.2F - p.x ), min( p.y, 2.4F - p.y ) ) : length( float2( outsideX, outsideY ) );
    float perimeter = exp( -pow( edgeMeters / .22F, 2.0F ) );
    float wash = saturate( .50F + .27F * sin( p.x * 1.73F - p.y * .91F + .4F )
        + .23F * sin( p.x * .63F + p.y * 2.11F - 1.2F ) );
    float settledBank = skirt * ( .008F + .120F * perimeter * ( .10F + .90F * wash * wash ) );
    float saddleBank = .165F * SoilGaussian( uv, float2( .20F, .32F ), float2( .125F, .20F ) )
        + .095F * SoilGaussian( uv, float2( .81F, .35F ), float2( .120F, .18F ) )
        + .140F * SoilGaussian( uv, float2( .73F, .74F ), float2( .185F, .16F ) )
        + .035F * SoilFan( p, float2( .42F, .64F ), float2( 1.02F, .79F ), .075F );
    return .11F + fieldFade * ( .145F * skirt + settledBank + saddleBank + reliefMask * rolling
        + .008F * sin( p.x * 1.7F + .4F ) * sin( p.y * 1.3F - .2F ) + .004F * sin( p.x * 4.1F + p.y * 2.3F ) );
}

MaterialShaderOutput MaterialShaderMain( in MaterialShaderInput materialInput )
{
    ByteAddressBuffer shaderDataBuffer = GetBuffer( RootCBV.m_shaderDataBuffer );

    CustomParameters customParameters = LoadCustomParameters
    (
        shaderDataBuffer,
        materialInput.m_primitive.GetShaderParametersOffsetIn32ByteBlocks()
    );

    MaterialShaderOutput materialOutput = MaterialShaderOutput::New( materialInput );

    float3 worldPosition = materialInput.m_vertex.m_worldPosition;
    float3 geometryNormal = normalize( materialInput.m_vertex.m_worldNormal );
    float3 materialNormal = geometryNormal;
    if( materialInput.m_vertex.m_uv.w > .5F && materialInput.m_vertex.m_color.a > .5F )
    {
        worldPosition = materialInput.m_vertex.m_uv.xyz; // birth world coordinates
        materialNormal = normalize( materialInput.m_vertex.m_color.rgb * 2.0F - 1.0F.xxx );
    }
    float3 axisSign = float3
    (
        materialNormal.x >= 0.0F ? 1.0F : -1.0F,
        materialNormal.y >= 0.0F ? 1.0F : -1.0F,
        materialNormal.z >= 0.0F ? 1.0F : -1.0F
    );

    float tileScaleMeters = max( customParameters.m_tileScaleMeters, 0.001F );
    float reciprocalTileScale = rcp( tileScaleMeters );
    SamplerState textureSampler = GetLinearWrapSampler();

    // Sign-aware coordinates keep opposing projections consistently oriented.
    float2 uvX = float2( worldPosition.z * axisSign.x, -worldPosition.y ) * reciprocalTileScale;
    float2 uvY = float2( worldPosition.x, -worldPosition.z * axisSign.y ) * reciprocalTileScale;
    float2 uvZ = float2( worldPosition.x * axisSign.z, worldPosition.y ) * reciprocalTileScale;

    float3 blendWeights = pow( abs( materialNormal ), 4.0F.xxx );
    blendWeights /= max( blendWeights.x + blendWeights.y + blendWeights.z, 0.0001F );

    // Sparse triplanar color keeps rounded cuts seamless but does not fetch
    // projections whose contribution is visually negligible. Procedural
    // cavity geometry already supplies the macro/micro surface normals, so
    // omitting three additional normal-map reads halves close-cavity shading.
    float4 albedo=0.0F.xxxx;float sampledWeight=0.0F;
    [branch] if(blendWeights.x>.025F){albedo+=customParameters.m_albedoTexture.Sample(textureSampler,uvX)*blendWeights.x;sampledWeight+=blendWeights.x;}
    [branch] if(blendWeights.y>.025F){albedo+=customParameters.m_albedoTexture.Sample(textureSampler,uvY)*blendWeights.y;sampledWeight+=blendWeights.y;}
    [branch] if(blendWeights.z>.025F){albedo+=customParameters.m_albedoTexture.Sample(textureSampler,uvZ)*blendWeights.z;sampledWeight+=blendWeights.z;}
    albedo/=max(sampledWeight,.0001F);

    // Preserve the authored mineral detail but pull the outcrop out of its
    // chalk-white range. Stable, broad fields shift between cooler quartz-rich
    // gray and warmer feldspar without looking like a second tiled texture.
    float mineralField = .50F + .25F * sin( dot( worldPosition.xy, float2( 1.17F, -1.63F ) ) + .7F )
        + .25F * sin( dot( worldPosition.xy, float2( 2.71F, 1.39F ) ) - 1.4F );
    float warmMineral = smoothstep( .34F, .72F, mineralField );
    float3 mineralTint = lerp( float3( .50F, .54F, .58F ), float3( .70F, .62F, .54F ), warmMineral );
    float mineralValue = .78F + .12F * sin( dot( worldPosition, float3( .71F, 1.09F, .83F ) ) + .2F );
    albedo.rgb *= mineralTint * mineralValue;

    // Dirt follows the actual seeded bank surface, climbing most strongly
    // where a fan or mound touches the granite and fading within a few inches.
    float2 localOutcrop = float2( worldPosition.x + 1.4F, worldPosition.y - 35.0F ) / float2( 4.2F, 2.4F );
    float2 localMeters = localOutcrop * float2( 4.2F, 2.4F );
    float soilContactZ = .12F + SeededSoilHeight( localMeters );
    float earthStain = 1.0F - smoothstep( -.035F, .30F, worldPosition.z - soilContactZ );
    earthStain *= .58F + .42F * saturate( 1.0F - materialNormal.z * .30F );
    float graniteLuma=dot(albedo.rgb,float3(.2126F,.7152F,.0722F));
    float3 earthTone=lerp(graniteLuma.xxx,albedo.rgb,.12F)*float3(.66F,.38F,.18F);
    albedo.rgb=lerp(albedo.rgb,earthTone,earthStain*.86F);

    // Darken only the narrow recess at the center of each geometric valley.
    // The broader indented granite keeps its ordinary material response.
    float creaseA=exp(-pow(SegmentDistance(localOutcrop,float2(.36F,.19F),float2(.44F,.73F))/.0030F,2.0F));
    float creaseB=exp(-pow(SegmentDistance(localOutcrop,float2(.55F,.53F),float2(.79F,.59F))/.0028F,2.0F));
    float crease=saturate(creaseA+creaseB)*(.82F+.18F*saturate(1.0F-materialNormal.z));
    albedo.rgb=lerp(albedo.rgb,albedo.rgb*float3(.10F,.085F,.075F),.92F*crease);

    // Restrained lichen on sheltered, lower, upward-facing granite. Two
    // incommensurate world-space fields avoid tiled patches and remain stable
    // across runtime fractures because the effect is derived from position.
    float lichenField=.50F+.25F*sin(dot(worldPosition,float3(5.31F,7.17F,4.73F))+1.4F)
        +.25F*sin(dot(worldPosition,float3(-3.83F,6.29F,8.11F))-2.1F);
    float sheltered=smoothstep(.18F,.72F,materialNormal.z)*saturate(.48F+.52F*materialNormal.y);
    float lowMoisture=1.0F-smoothstep(.82F,1.34F,worldPosition.z);
    float lichen=smoothstep(.60F,.86F,lichenField)*sheltered*lowMoisture*.40F;
    graniteLuma=dot(albedo.rgb,float3(.2126F,.7152F,.0722F));
    float3 lichenTone=lerp(graniteLuma.xxx,albedo.rgb,.45F)*float3(.68F,.78F,.43F);
    albedo.rgb=lerp(albedo.rgb,lichenTone,lichen);

    materialOutput.m_albedo = albedo.rgb;
    materialOutput.m_opacity = albedo.a * customParameters.m_opacity;
    materialOutput.m_normal = geometryNormal;
    materialOutput.m_metalness = 0.0F;
    materialOutput.m_roughness = saturate( customParameters.m_roughness + lichen*.08F + crease*.07F );
    materialOutput.m_occlusion = 1.0F;

    return materialOutput;
}
